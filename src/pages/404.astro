---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found | yeboah.works"
  description="This page does not exist. Head back to yeboah.works."
  noFooter={true}
>
  <main class="four-oh-four">
    <div class="four-oh-four__inner">
      <p class="four-oh-four__code" aria-hidden="true">404</p>
      <h1 class="four-oh-four__message">You've wandered off the path</h1>
      <p class="four-oh-four__note">
        This page does not exist, or it moved somewhere I have not mapped yet. Either way, here is a
        way back.
      </p>
      <a href="/" class="btn">Back to the homepage</a>
    </div>
  </main>
</Base>
