---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import tracks from '../data/portfolio.json';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

function formatDate(d) {
  return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
}

const trackBlurbs = {
  research: 'Published papers, NLP projects, policy briefs, and flood forecasting models.',
  comms: 'Over a thousand stories, media campaigns, and brand communications.',
  events: 'Spelling bees, university events, and speaking appearances.',
  civic: 'Budget tracking, peacebuilding research, and voter education.',
  built: "Logalab, Yeboah's Notes, CAGAD, and other projects.",
};
---

<Base
  title="Acquah Yeboah | Researcher, writer and builder"
  description="Personal site of Acquah Yeboah, also writing as Acquah Nana Yeboah. Nigerian researcher, writer and builder working on governance and African tech."
>
  <section class="hero">
    <div class="hero__content">
      <div class="hero__text">
        <h1 class="hero__name">Yeboah<span>.</span></h1>
        <p class="hero__tagline">Researcher. Writer. Builder.</p>
      </div>
      <div class="hero__portrait">
        <img
          src="/img/Yeboah.png"
          alt="Acquah Yeboah"
          class="hero__portrait-img"
          width="400"
          height="533"
          fetchpriority="high"
        />
        <div class="hero__portrait-frame" aria-hidden="true"></div>
      </div>
    </div>
    <div class="hero__scroll-hint" aria-hidden="true">
      <span>scroll</span>
      <div class="hero__scroll-line"></div>
    </div>
  </section>

  <section class="welcome">
    <div class="welcome__inner">
      <p class="welcome__quote reveal">
        This is where I keep my work, my writing, and whatever I'm thinking about. None of it is
        finished. Neither am I. Look around.
      </p>
      <div class="welcome__bio reveal reveal--delay-1">
        <p>
          I'm Yeboah. I grew up between Torugbene, Warri, and Yenagoa in southern Nigeria. I studied
          political science, got into governance research, and ended up covering African tech
          startups for a living. Along the way, I co-founded a governance non-profit, started a
          civic tech project, and moved to Morocco for a master's degree.
        </p>
        <p>
          Right now, I'm in Rabat, finishing a master's in collective intelligence at UM6P and
          working as a research intern at Africa Business School.
        </p>
        <a href="/about" class="section-link">
          More about me <span class="section-link__arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="writing-preview">
    <div class="writing-preview__inner">
      <p class="eyebrow reveal">Recent writing</p>
      <h2 class="reveal reveal--delay-1">Yeboah's Notes</h2>
      <div class="writing-preview__list">
        {posts.length === 0 && <p class="text-muted">Nothing published yet.</p>}
        {posts.map((post) => (
          <article class="post-card reveal">
            {post.data.tags.length > 0 && (
              <div class="post-card__tags">
                {post.data.tags.map((tag) => <span class="post-card__tag">{tag}</span>)}
              </div>
            )}
            <h3 class="post-card__title">
              <a href={`/writing/${post.id}`}>{post.data.title}</a>
            </h3>
            <p class="post-card__date">
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            </p>
            <p class="post-card__excerpt">{post.data.description}</p>
          </article>
        ))}
      </div>
      <a href="/writing" class="section-link reveal" style="margin-top: 2rem;">
        All writing <span class="section-link__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="portfolio-preview">
    <div class="portfolio-preview__inner">
      <p class="eyebrow reveal">What I do</p>
      <h2 class="reveal reveal--delay-1">Five tracks</h2>
      <div class="portfolio-preview__tracks reveal reveal--delay-2">
        {tracks.map((track) => (
          <a href={`/portfolio#${track.id}`} class="track-card">
            <span class="track-card__number">{track.number}</span>
            <div class="track-card__content">
              <h3 class="track-card__name">{track.name}</h3>
              <p class="track-card__desc">{trackBlurbs[track.id]}</p>
            </div>
          </a>
        ))}
      </div>
      <a href="/portfolio" class="section-link reveal" style="margin-top: 2rem;">
        Full portfolio <span class="section-link__arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  <section class="shelf">
    <div class="shelf__inner">
      <p class="eyebrow reveal">My shelf</p>
      <h2 class="reveal reveal--delay-1">What I'm reading and listening to</h2>
      <div class="shelf__grid reveal reveal--delay-2">
        <div class="shelf__column">
          <h3>Reading</h3>
          <div id="gr_custom_widget_1784999268">
            <div class="gr_custom_container_1784999268">
              <noscript>
                Book reviews and ratings on
                <a rel="nofollow" href="https://www.goodreads.com/review/list/86244076-acquah-yeboah?shelf=read">Goodreads</a>.
              </noscript>
            </div>
          </div>
          <script
            is:inline
            src="https://www.goodreads.com/review/custom_widget/86244076.Acquah's%20bookshelf:%20read?cover_position=left&cover_size=small&num_books=7&order=a&shelf=read&show_author=1&show_cover=1&show_rating=1&show_review=0&show_tags=0&show_title=1&sort=date_added&widget_bg_color=FFFFFF&widget_bg_transparent=&widget_border_width=1&widget_id=1784999268&widget_text_color=000000&widget_title_size=medium&widget_width=medium"
            type="text/javascript"
            charset="utf-8"></script>
          <a
            href="https://www.goodreads.com/review/list/86244076-acquah-yeboah?shelf=read"
            target="_blank"
            rel="noopener"
            class="section-link mt-2"
            style="font-size:0.75rem;">
            See all on Goodreads <span class="section-link__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="shelf__column">
          <h3>Listening</h3>
          <div class="spotify-container">
            <iframe
              style="border-radius:12px"
              src="https://open.spotify.com/embed/playlist/0O3JPzX2NBJTVLyi1J6D3f?utm_source=generator&theme=0"
              width="100%"
              height="352"
              frameborder="0"
              allowfullscreen
              allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              loading="lazy"
              title="Yeboah's Spotify playlist"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="subscribe">
    <div class="subscribe__inner reveal">
      <p class="eyebrow">Stay in the loop</p>
      <h2>Subscribe to Yeboah's Notes</h2>
      <p class="text-muted">
        Thoughts on African tech, business, and policy. No spam, just writing.
      </p>
      <a
        href="https://yeboah.substack.com/subscribe?utm_source=menu&simple=true&next=https%3A%2F%2Fyeboah.substack.com%2Fapi%2Fv1%2Ffree%3Fnojs%3Dtrue"
        target="_blank"
        rel="noopener"
        class="btn"
        style="display:inline-block;margin-top:1.5rem;">Subscribe now</a>
      <p class="subscribe__note">Opens Substack in a new tab.</p>
    </div>
  </section>
</Base>
