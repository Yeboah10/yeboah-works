---
const year = new Date().getFullYear();

const socials = [
  { href: 'https://www.linkedin.com/in/yeboah01/', label: 'LinkedIn' },
  { href: 'https://www.instagram.com/yeboah_01', label: 'Instagram' },
  { href: 'https://yeboah.substack.com/', label: 'Substack' },
];
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__left">&copy; {year} Acquah Yeboah</div>
    <div class="footer__socials">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="me noopener" class="footer__social-link">{s.label}</a>
      ))}
    </div>
    <p class="footer__colophon">Built by Yeboah and Claude Code. Set in Gloock and Karla.</p>
  </div>
</footer>
